# ===== Neo Matrix 环境配置示例 =====
# 复制为 .env 并按需修改：cp .env.example .env

# 服务端口
PORT=3000

# 调试模式（true 输出详细日志，生产关闭）
DEBUG=false

# ===== 必须设置 =====
# 会话签名密钥（重启后会话是否保持、多节点是否互踢都取决于它）。
# 生成方式：openssl rand -hex 32
# SESSION_SECRET=

# ===== 数据库（默认 SQLite，生产建议 MySQL/PostgreSQL）=====
# SQL_DSN=root:password@tcp(localhost:3306)/neo-matrix
# LOG_SQL_DSN=            # 可选：日志独立库

# ===== 供给方成本倍率上限（相对官方价，默认 3.0）=====
# MAX_COST_RATIO=3.0

# ===== 信任阶梯惩罚力度（低信任渠道在路由里的成本放大倍数，默认 5.0/3.0）=====
# TRUST_PENALTY_LV1=5.0
# TRUST_PENALTY_LV2=3.0

# ===== 后台任务 =====
# 结算周期（秒），留空关闭自动结算。如按天结算：86400
# SETTLEMENT_FREQUENCY=86400
# 批量落库（true 开启，减少 DB 写入压力）
# BATCH_UPDATE_ENABLED=true
# 渠道自动测试频率（秒），留空关闭
# CHANNEL_TEST_FREQUENCY=600

# ===== 缓存 =====
# 内存缓存（true 开启，多机部署必须配合 Redis）
# MEMORY_CACHE_ENABLED=true
# 渠道/选项缓存同步频率（秒，默认 600）
# SYNC_FREQUENCY=600
# REDIS_CONN_STRING=redis://localhost:6379

# ===== 首次启动管理员 =====
# INITIAL_ROOT_TOKEN=      # 首次启动为 root 账号创建的令牌
# INITIAL_ROOT_ACCESS_TOKEN=  # 首次启动 root 的 access token

# ===== tiktoken 离线缓存目录（离线/内网部署必须设置）=====
# 先在有网机器预下载词表到该目录，或按 docs/DEPLOYMENT.md 指引
# TIKTOKEN_CACHE_DIR=/data/tiktoken-cache

# ===== 可选：上游代理（用于访问海外模型厂商）=====
# 仅当你的服务器需要代理访问上游时才设置，非本机代理！
# HTTPS_PROXY=
